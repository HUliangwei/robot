# ============ 重型/不可推送内容 ============
# conda 环境（~4GB）、数据集缓存（~11GB）、MuJoCo 二进制（44MB）
envs/
datasets/
tool/
archives/

# ============ 模型权重（GitHub 限制单文件 100MB） ============
**/*.safetensors
**/training_state/
**/optimizer_state*
**/rng_state*
**/checkpoints/

# ============ 中间训练产物 ============
**/outputs/train/

# ============ Python / 编辑器缓存 ============
__pycache__/
*.pyc
.vscode/
.idea/

# ============ 杂项 ============
*.log
.DS_Store
Thumbs.db
gui/.runs/

# LIBERO 本机配置（含绝对路径）
workspace/libero/.libero/

# ============ RL 运行瞬时产物 ============
workspace/libero/rl_configs/generated/
workspace/libero/rl_scripts/logs/
