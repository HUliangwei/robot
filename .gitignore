# ============ 重型/不可推送内容 ============
# conda 环境（~4GB）、数据集缓存（~11GB）、MuJoCo 二进制（44MB）
envs/
tool/
archives/

# ============ 模型权重（GitHub 限制单文件 100MB） ============
**/*.safetensors
**/training_state/
**/optimizer_state*
**/rng_state*
**/checkpoints/

# ============ 中间训练产物 ============
**/outputs/train/

# ============ Python / 编辑器缓存 ============
__pycache__/
*.pyc
.vscode/
.idea/

# ============ 杂项 ============
*.log
.DS_Store
Thumbs.db

# LIBERO 本机配置（含绝对路径）
workspace/libero/.libero/

# ============ RL 运行瞬时产物 ============
workspace/libero/rl_configs/generated/
workspace/libero/rl_scripts/logs/

# 实时推流瞬时帧
**/outputs/stream/

# BEGIN RLW V3 MANAGED
# machine-local RLW state
.rlw/
.rlw_migration_backup/

# local provider environments/tools/caches
envs/
tool/
archives/

# dataset payload/cache: manifests + small metadata remain trackable
datasets/hub/
datasets/**/raw/
datasets/**/cache/
datasets/**/data/
datasets/**/processed/
datasets/**/payload/
datasets/**/*.parquet
datasets/**/*.mp4
datasets/**/*.avi
datasets/**/*.mkv

# Run-owned heavy payload
runs/**/logs/
runs/**/checkpoints/
runs/**/rollouts/
runs/**/evaluation/native/
runs/**/artifacts/
runs/**/*.safetensors
runs/**/*.pt
runs/**/*.pth
runs/**/*.ckpt
runs/**/*.mp4

# model/optimizer state anywhere
**/*.safetensors
**/training_state/
**/optimizer_state*
**/rng_state*
**/checkpoints/

# legacy runtime/transient outputs
workspace/**/outputs/train/
workspace/**/outputs/stream/
workspace/**/rl_configs/generated/
workspace/**/rl_scripts/logs/
legacy/gui_dashboard_v4/.runs/

# Python/editor/runtime
__pycache__/
*.pyc
.vscode/
.idea/
*.log
.DS_Store
Thumbs.db
