<mujoco model="pusht">
  <option gravity="0 0 0" integrator="Euler" timestep="0.01"/>

  <visual>
    <global offheight="1024" offwidth="1024"/>
  </visual>

  <asset>
    <material name="flat" specular="0" shininess="0"/>
  </asset>

  <default>
    <geom friction="1 0.01 0.01" material="flat"/>
  </default>

  <worldbody>
    <!-- directional light from above; ambient+diffuse = 1.0 so rendered colors match geom rgba (pygame-like) -->
    <light name="sun" pos="256 256 2000" dir="0 0 -1" directional="true" diffuse="0.9 0.9 0.9" ambient="0.1 0.1 0.1" castshadow="false"/>

    <!-- white background plane (non-colliding) -->
    <geom name="background" type="plane" size="800 800 0.01" pos="256 256 -0.1" rgba="1 1 1 1" contype="0" conaffinity="0"/>

    <!-- goal zone: ghost T at goal pose (256,256,45deg), non-colliding, drawn beneath the block; rgb pre-scaled -> renders LightGreen(144,238,144) -->
    <body name="goal" pos="256 256 0" quat="0.92388 0 0 0.38268">
      <geom name="goal_head" type="box" size="60 15 3" pos="0 -30 -0.02" rgba="0.377 0.622 0.377 0.9" contype="0" conaffinity="0"/>
      <geom name="goal_stem" type="box" size="15 45 3" pos="0 30 -0.02" rgba="0.377 0.622 0.377 0.9" contype="0" conaffinity="0"/>
    </body>

    <!-- walls (static): inner play area roughly [7,505]x[7,505] like gym_pusht segments; rgb pre-scaled 0.67 -> renders LightGray(211) -->
    <geom name="wall_left"   type="box" size="2 251 3"   pos="5 256 0" rgba="0.55 0.55 0.55 1"/>
    <geom name="wall_right"  type="box" size="2 251 3"   pos="507 256 0" rgba="0.55 0.55 0.55 1"/>
    <geom name="wall_top"    type="box" size="251 2 3"   pos="256 5 0" rgba="0.55 0.55 0.55 1"/>
    <geom name="wall_bottom" type="box" size="251 2 3"   pos="256 507 0" rgba="0.55 0.55 0.55 1"/>

    <!-- agent: heavy dynamic cylinder driven by direct velocity commands (approximates pymunk kinematic body);
         qpos[0:3] = [x, y, theta] absolute position; rgb pre-scaled -> renders RoyalBlue(65,105,225) -->
    <body name="agent" pos="0 0 0">
      <joint name="agent_x" type="slide" axis="1 0 0"/>
      <joint name="agent_y" type="slide" axis="0 1 0"/>
      <joint name="agent_theta" type="hinge" axis="0 0 1"/>
      <geom name="agent_geom" type="cylinder" size="15 3" pos="0 0 0" rgba="0.17 0.275 0.588 1" density="0.05"/>
    </body>

    <!-- T block: dynamic, COM at (0,45) below junction point like gym_pusht; qpos[3:6] = [x, y, theta];
         rgb pre-scaled -> renders LightSlateGray(119,136,153) -->
    <body name="block" pos="0 0 0">
      <joint name="block_x" type="slide" axis="1 0 0"/>
      <joint name="block_y" type="slide" axis="0 1 0"/>
      <joint name="block_theta" type="hinge" axis="0 0 1"/>
      <body name="block_com" pos="0 45 0">
        <geom name="block_head" type="box" size="60 15 3" pos="0 -30 0" rgba="0.31 0.355 0.4 1" density="2.65e-5"/>
        <geom name="block_stem" type="box" size="15 45 3" pos="0 30 0" rgba="0.31 0.355 0.4 1" density="2.65e-5"/>
      </body>
    </body>

    <!-- top-down camera; image rows follow -y_cam so caller flips vertically for pygame y-down convention -->
    <camera name="top" pos="256 256 618.05" xyaxes="1 0 0 0 1 0" fovy="45"/>
  </worldbody>
</mujoco>
